{
  "name": "ghostbrain",
  "version": "0.0.1",
  "private": true,
  "description": "GhostBrain Commercial AI Desktop Suite & Cloud Relay",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @ghostbrain/desktop dev",
